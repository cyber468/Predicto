# Copy this file to .env (in the repo root) and fill in real values.
# All variables are optional for local development — sensible defaults
# are used when they're not set (see predictor/predictor/settings.py).

# A strong, random Django secret key. Required for any non-local deployment.
DJANGO_SECRET_KEY=

# "True" or "False". Keep True for local dev, set False in production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Gmail (or other SMTP) account used to email quiz results to users.
# Leave blank to skip emailing results (the app still shows them on-screen).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: path of the SQLite file (defaults to predictor/db.sqlite3). Handy for tests.
DJANGO_DB_PATH=
